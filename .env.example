# -----------------------------------------------------------------------------
# Yerel sırlar: bu dosyanın içeriği repoda OK (boş/placeholder).
# GERÇEK değerler proje kökündeki .env dosyasında olmalı.
# .env ve .env.local Git tarafından izlenmez — bkz. .gitignore ve README.
# Kurulum:  cp .env.example .env  → sonra aşağıdaki alanları doldurun.
# -----------------------------------------------------------------------------

# --- Gemini (LLM)
# Kod: backend/app/llm/gemini_client.py

# Google AI Studio / Vertex ile alınır. Boş bırakılırsa Gemini devre dışı kalır.
GEMINI_API_KEY=

# Opsiyonel. Boşsa uygulama varsayılan model adını kullanır.
# GEMINI_MODEL=gemini-2.0-flash

# Opsiyonel: 1, true, yes, on — model deneme loglarını konsola döker.
# GEMINI_VERBOSE=0

# --- SMTP (giden e-posta)
# Kod: backend/app/services/email_service.py

SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Boşsa genelde SMTP_USER “From” olarak kullanılır.
SMTP_FROM=

# --- Taslak e-posta varsayılan alıcıları (opsiyonel)
# Kod: backend/app/llm/gemini_client.py — taslak önerilerindeki placeholder adresleri geçersiniz.

# DEFAULT_KARGO_MAIL_TO=kargo.ornek@sirket.com
# DEFAULT_TEDARIK_MAIL_TO=tedarik.ornek@sirket.com
# DEFAULT_DEPO_MAIL_TO=depo.ornek@sirket.com
